# --- Flask ---
SECRET_KEY=change-this-to-a-long-random-string
FLASK_ENV=production
BASE_URL=https://yourdomain.com
# Set to true once deployed behind real HTTPS — keep false for local http://localhost testing
SESSION_COOKIE_SECURE=false

# --- Database ---
# Postgres connection string, e.g. from Railway/Render/Supabase
DATABASE_URL=postgresql://user:password@host:5432/ticketsales

# --- Email (magic link login) ---
# Any SMTP provider works (Gmail app password, SendGrid, Resend, Postmark, etc.)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM="Event Tickets <your-email@gmail.com>"

# --- Razorpay Payment Gateway ---
# From dashboard.razorpay.com > Settings > API Keys
# Test mode keys (rzp_test_...) work immediately with no approval needed
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret

# From dashboard.razorpay.com > Settings > Webhooks — a secret YOU set
# when creating the webhook (different from the API key/secret above)
RAZORPAY_WEBHOOK_SECRET=choose-a-strong-webhook-secret
# SANDBOX for UAT testing, PRODUCTION once PhonePe approves your merchant account

# Credentials YOU pick and configure in the PhonePe dashboard for webhook auth
# (different from client id/secret above) — used to verify inbound webhooks
PHONEPE_WEBHOOK_USERNAME=choose-a-webhook-username
PHONEPE_WEBHOOK_PASSWORD=choose-a-strong-webhook-password

# --- Admin bootstrap ---
# The first account with this email is auto-marked as admin on first login
ADMIN_EMAIL=you@yourorg.com
